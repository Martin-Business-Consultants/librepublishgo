{
  "name": "@librepublish/astro",
  "version": "0.3.3",
  "description": "Build an Astro site on LibrePublish CMS (the Go core): schema-locked typed content loaders, live collections, generated types, blocks, rich text, branding, images, SEO, live forms, sitemap, redirects, cache purges and build checks",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin-Business-Consultants/librepublishgo.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/Martin-Business-Consultants/librepublishgo/tree/main/packages/astro#readme",
  "keywords": [
    "astro-integration",
    "withastro",
    "cms",
    "headless-cms",
    "librepublish",
    "cloudflare",
    "forms",
    "turnstile"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "default": "./dist/rich-text.js"
    },
    "./branding": {
      "types": "./dist/branding.d.ts",
      "default": "./dist/branding.js"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "default": "./dist/loaders.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./forms/rules": {
      "types": "./dist/forms/rules.d.ts",
      "default": "./dist/forms/rules.js"
    },
    "./schema": {
      "types": "./dist/schema/zod.d.ts",
      "default": "./dist/schema/zod.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/components",
    "bin"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "e2e": "node test/e2e/run.mjs",
    "contracts:pin": "node test/contracts-pin.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.2"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "astro": "^7.4.0",
    "typescript": "^5.9.0"
  },
  "bugs": {
    "url": "https://github.com/Martin-Business-Consultants/librepublishgo/issues"
  },
  "bin": {
    "librepublish-astro": "./bin/librepublish-astro.mjs"
  }
}
