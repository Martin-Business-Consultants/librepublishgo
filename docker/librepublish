#!/bin/sh
# librepublish in the image: the real binary, run as the image's own user
# (app). Hosts mount their own volume at the data directory, often owned by
# root, and `docker exec … librepublish user create` runs as root: started as
# root, this gives the data directory to app and runs the binary as app, so
# nothing in it ends up owned by anyone else. Started as another user (a host
# that sets one), it runs the binary as that user.
set -e
dir="${DATA_DIR:-/data}"
if [ "$(id -u)" = 0 ]; then
  mkdir -p "$dir"
  # Only a directory not app's yet is walked (a fresh volume): every start
  # after that skips it. The walk never follows a symlink (-P), and a link
  # is chowned itself, not what it points to (-h), so a link planted in the
  # volume can't hand app a file outside it.
  if [ -n "$(find -P "$dir" -maxdepth 0 \! -user app)" ]; then
    find -P "$dir" \! -user app -exec chown -h app:app {} +
  fi
  exec su-exec app:app /usr/local/libexec/librepublish "$@"
fi
exec /usr/local/libexec/librepublish "$@"
